{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "collectd plugin",
      "type": "cppdbg",
      "request": "launch",
      "program": "/ros_ws/install/collectd_vendor/bin/collectd",
      "args": [
        "-f",
        "-C",
        "${workspaceFolder}/src/resource_diagnostics_utils/config/collectd.conf"
      ],
      "cwd": "/ros_ws",
      "MIMode": "gdb",
      "setupCommands": [
        {
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "debug"
    },
    {
      "name": "ROS: Attach",
      "type": "ros2",
      "request": "attach"
    },
    {
      "name": "ROS: Launch",
      "type": "ros2",
      "request": "launch",
      "target": "${file}",
      "arguments": [
        "config_file_path:=${input:config_file_path}"
      ]
    }
  ],
  "inputs": [
    {
      "id": "config_file_path",
      "type": "promptString",
      "description": "Enter the path to the config file",
      "default": ""
    }
  ]
}
