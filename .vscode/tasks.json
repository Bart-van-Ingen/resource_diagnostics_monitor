{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        // Build tasks
        {
            "label": "build",
            "detail": "Build workspace (default)",
            "type": "shell",
            "command": "./.vscode/tasks/build.sh",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "build package",
            "detail": "Build a specific package",
            "type": "shell",
            "command": "./.vscode/tasks/build.sh --packages-select ${input:package}",
            "group": "build",
            "problemMatcher": "$gcc"
        },
        {
            "label": "debug",
            "detail": "Build workspace (debug)",
            "type": "shell",
            "command": "./.vscode/tasks/build.sh",
            "options": {
                "env": {
                    "BUILD_TYPE": "Debug"
                }
            },
            "group": "build",
            "problemMatcher": "$gcc"
        },
        // Test tasks
        {
            "label": "test",
            "detail": "Run all unit tests and show results.",
            "type": "shell",
            "command": "./.vscode/tasks/test.sh",
            "group": {
                "kind": "test",
                "isDefault": true
            }
        },
        // Clean
        {
            "label": "clean",
            "detail": "Run the clean target",
            "type": "shell",
            "command": "colcon build --cmake-target clean",
            "problemMatcher": "$gcc"
        },
        {
            "label": "purge",
            "detail": "Purge workspace by deleting all generated files.",
            "type": "shell",
            "command": "sudo rm -fr build install log; sudo py3clean .",
            "problemMatcher": []
        },
        // Linting and static code analysis tasks
        // These invoke the ament_* CLI tools directly. They used to use "type": "ament", which
        // was provided by the discontinued ms-iot.vscode-ros extension. Its replacement,
        // ranch-hand-robotics.rde-ros-2, only registers the "ROS2" and "colcon" task types, so
        // "ament" tasks and the "$ament_*" problem matchers no longer resolve to anything.
        {
            "label": "cpplint",
            "detail": "Lint files with cpplint.",
            "type": "shell",
            "command": "ament_cpplint src/",
            "problemMatcher": {
                "owner": "ament_cpplint",
                "source": "cpplint",
                "severity": "warning",
                "fileLocation": [
                    "autoDetect",
                    "${workspaceFolder}"
                ],
                "pattern": {
                    "regexp": "^(.+?):(\\d+):\\s+(.+?)\\s+\\[(\\S+)\\]\\s+\\[\\d+\\]$",
                    "file": 1,
                    "line": 2,
                    "message": 3,
                    "code": 4
                }
            },
            "presentation": {
                "panel": "dedicated",
                "reveal": "silent",
                "clear": true
            }
        },
        {
            "label": "cppcheck",
            "detail": "Run static code checker cppcheck.",
            "type": "shell",
            "command": "ament_cppcheck src/",
            "problemMatcher": {
                "owner": "ament_cppcheck",
                "source": "cppcheck",
                "severity": "error",
                "fileLocation": [
                    "autoDetect",
                    "${workspaceFolder}"
                ],
                "pattern": {
                    "regexp": "^\\[(.+?):(\\d+)\\]:\\s+\\(([^)]+)\\)\\s+(.+)$",
                    "file": 1,
                    "line": 2,
                    "code": 3,
                    "message": 4
                }
            },
            "presentation": {
                "panel": "dedicated",
                "reveal": "silent",
                "clear": true
            },
            "options": {
                "env": {
                    "AMENT_CPPCHECK_ALLOW_SLOW_VERSIONS": "1"
                }
            }
        },
        {
            "label": "lint_cmake",
            "detail": "Run lint on cmake files.",
            "type": "shell",
            "command": "ament_lint_cmake src/",
            "problemMatcher": {
                "owner": "ament_lint_cmake",
                "source": "lint_cmake",
                "severity": "warning",
                "fileLocation": [
                    "autoDetect",
                    "${workspaceFolder}"
                ],
                "pattern": {
                    "regexp": "^(.+?):(\\d+):\\s+(.+?)\\s+\\[(\\S+)\\]$",
                    "file": 1,
                    "line": 2,
                    "message": 3,
                    "code": 4
                }
            },
            "presentation": {
                "panel": "dedicated",
                "reveal": "silent",
                "clear": true
            }
        },
        {
            "label": "flake8",
            "detail": "Run flake8 on python files.",
            "type": "shell",
            "command": "ament_flake8 src/",
            "problemMatcher": {
                "owner": "ament_flake8",
                "source": "flake8",
                "severity": "warning",
                "fileLocation": [
                    "autoDetect",
                    "${workspaceFolder}"
                ],
                "pattern": {
                    "regexp": "^(.+?):(\\d+):(\\d+):\\s+([A-Z]+\\d+)\\s+(.+)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "code": 4,
                    "message": 5
                }
            },
            "presentation": {
                "panel": "dedicated",
                "reveal": "silent",
                "clear": true
            }
        },
        {
            "label": "pep257",
            "detail": "Run pep257 on python files.",
            "type": "shell",
            "command": "ament_pep257 src/",
            "problemMatcher": {
                "owner": "ament_pep257",
                "source": "pep257",
                "severity": "warning",
                "fileLocation": [
                    "autoDetect",
                    "${workspaceFolder}"
                ],
                "pattern": {
                    "regexp": "^(.+?):(\\d+) in .+?: (D\\d+): (.+)$",
                    "file": 1,
                    "line": 2,
                    "code": 3,
                    "message": 4
                }
            },
            "presentation": {
                "panel": "dedicated",
                "reveal": "silent",
                "clear": true
            }
        },
        {
            "label": "lint all",
            "detail": "Run all linters.",
            "dependsOn": [
                "cppcheck",
                "cpplint",
                "flake8",
                "lint_cmake",
                "pep257",
            ],
            "problemMatcher": []
        },
        // Workspace editing tasks
        {
            "label": "new ament_cmake package",
            "detail": "Create a new ROS cpp package from a template.",
            "type": "shell",
            "command": "ros2 pkg create --destination-directory src --build-type ament_cmake ${input:newPackageName}",
            "problemMatcher": []
        },
        {
            "label": "new ament_python package",
            "detail": "Create a new ROS python package from a template.",
            "type": "shell",
            "command": "ros2 pkg create --destination-directory src --build-type ament_python ${input:newPackageName}",
            "problemMatcher": []
        },
        {
            "label": "import from workspace file",
            "detail": "Use vcs to import modules specified by a workspace/rosinstall file.",
            "type": "shell",
            "command": "envsubst < src/ros2.repos | vcs import src",
            "problemMatcher": []
        },
        {
            "label": "update workspace file",
            "detail": "Use vcs to update repositories in src to workspace file.",
            "type": "shell",
            "command": "vcs export src > src/ros2.repos",
            "problemMatcher": []
        },
        {
            "label": "install dependencies",
            "detail": "Install all dependencies specified in the workspaces package.xml files.",
            "type": "shell",
            "command": "sudo apt-get update && rosdep update && rosdep install --from-paths src --ignore-src -y",
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "package",
            "type": "pickString",
            "description": "Select ROS package",
            "options": [
                "resource_diagnostics_updater_py",
                "resource_diagnostics_updater_cpp",
                "resource_monitor_interfaces",
                "telegraf_resource_monitor",
                "resource_monitor_cpp",
                "collectd_socket_writer"
            ]
        },
        {
            "id": "newPackageName",
            "type": "promptString",
            "description": "Name of the new ROS package"
        }
    ]
}