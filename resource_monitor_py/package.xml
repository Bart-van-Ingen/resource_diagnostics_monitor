<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>resource_monitor_py</name>
  <version>0.0.0</version>
  <description>integrates cloud native Telegraf with ROS 2 to monitor system resources and publish
them as ROS messages in an easily configurable way using Python.</description>
  <maintainer email="van.ingen.bart@gmail.com">Bart</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>resource_monitor_interfaces</exec_depend>
  <exec_depend>resource_diagnostics_utils</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>telegraf_vendor</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
